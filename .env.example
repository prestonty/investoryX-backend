# Local db
# DATABASE_URL=postgresql://postgres:<password>@localhost:5432/investoryX_db

# Docker (default): uses the 'db' service name as the host
DATABASE_URL=postgresql://postgres:<password>@db:5432/investoryx_db


POSTGRES_USER=postgres
POSTGRES_PASSWORD=password123
POSTGRES_DB=investoryx_db

# Generate each with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
# Separate key for refresh tokens (falls back to SECRET_KEY if unset)
REFRESH_SECRET_KEY=change-me-too
REFRESH_TOKEN_EXPIRE_DAYS=1
ALGORITHM=HS256
# Short-lived; the frontend refreshes automatically via the httpOnly refresh cookie
ACCESS_TOKEN_EXPIRE_MINUTES=15

FRONTEND_BASE_URL=http://localhost:3000
CORS_ORIGINS=https://investory-six.vercel.app,https://www.investoryx.ca
RESEND_API_KEY=re_123456789qwerty
DISABLE_EMAIL_VERIFICATION=false

# Never true in production: returns raw exception text to clients
DEBUG_ERRORS=false
# Set to production to send auth cookies with the Secure flag (HTTPS only)
ENVIRONMENT=development
# Production: .investoryx.ca so the API (api.investoryx.ca) and frontend server share auth cookies.
# Leave unset locally.
# COOKIE_DOMAIN=.investoryx.ca

RATE_LIMIT_ENABLED=true
# true only behind a proxy that sets X-Forwarded-For (e.g. Railway); otherwise spoofable
TRUST_PROXY_HEADERS=false

CELERY_BROKER_URL=redis://localhost:6379/0
# Task results (backtests) are stored in Postgres; defaults to db+$DATABASE_URL when unset
# CELERY_RESULT_BACKEND=db+postgresql://postgres:<password>@db:5432/investoryx_db
# Market-data cache + rate-limit counters (defaults to the Redis host, db 2)
# CACHE_REDIS_URL=redis://localhost:6379/2
CELERY_TIMEZONE=America/New_York
CELERY_BEAT_ENABLED=true

# Stock listings for the seed and the daily new-listing sync (free key: alphavantage.co)
ALPHAVANTAGE_API_KEY=ASDFGHJKL

# Paper-trading costs applied to every simulated fill
SIM_FEE_PER_TRADE=0
SIM_SLIPPAGE_BPS=0
# Optional cap on a single buy's notional value (blank = no cap)
SIM_MAX_ORDER_VALUE=

# Enables /dev/run-pipeline (trades for every user). Must be false in production.
DEV_MODE=true
PORT=8000